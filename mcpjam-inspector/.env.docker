# ──────────────────────────────────────────────────────────────
# MCPJam Inspector – Docker environment template
# Copy this file and fill in your values:
#   cp .env.docker .env
# Then start with:
#   docker compose up --build
# ──────────────────────────────────────────────────────────────

# ── LLM Gateway ─────────────────────────────────────────────
# Required – OpenAI-compatible endpoint
LLM_SERVER_URL=http://host.docker.internal:4000/v1/chat/completions

# Comma-separated model list shown in the Chat model selector
LLM_MODELS=gpt-4,gpt-4o,claude-3-5-sonnet

# API key for the LLM gateway (passed as Bearer token)
LLM_API_KEY=your-api-key-here

# ── LLM OAuth (optional) ───────────────────────────────────
# Uncomment if your gateway uses OAuth client-credentials flow
# LLM_OAUTH_ENDPOINT=https://auth.example.com/oauth/token
# LLM_CLIENT_ID=your-client-id
# LLM_CLIENT_SECRET=your-client-secret
# LLM_OAUTH_SCOPE=read
# LLM_OAUTH_GRANT_TYPE=client_credentials
# LLM_VERIFY_SSL=true

# ── Internal Auth ───────────────────────────────────────────
# Display identity shown in the UI (no real login required)
MCPJAM_INTERNAL_USER_EMAIL=admin@internal.local
MCPJAM_INTERNAL_USER_NAME=Internal Admin

# ── Convex / Evals (optional) ──────────────────────────────
# Only needed if you want the Evals tab to work
# CONVEX_URL=https://your-convex.cloud
# CONVEX_HTTP_URL=https://your-convex.cloud
# CONVEX_AUTH_TOKEN=your-convex-service-token
