# ─────────────────────────────────────────────────────────────────────────────
# Deep Research Agent — LOCAL DEVELOPMENT environment
#
# Start the dev stack first:
#   docker compose -f deep_research/docker-compose.dev.yml up -d
#
# Then run the service:
#   uvicorn deep_research.server:app --port 8000 --env-file deep_research/.env.dev
#
# Remove from VCS before pushing to corporate environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Gateway ──────────────────────────────────────────────────────────────
# Point to your real LLM endpoint (OpenAI-compatible API).
# For stub mode (no LLM calls) the agent will return placeholder text.
LLM_SERVER_URL=http://localhost:8080/v1/chat/completions
LLM_MODEL_NAME=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120.0

# Optional: OAuth or API key (leave blank for open/stub local LLM)
# LLM_OAUTH_ENDPOINT=
# LLM_CLIENT_ID=
# LLM_CLIENT_SECRET=
LLM_API_KEY=sk-dev-placeholder

# ── MCP Data Sources (mock server) ───────────────────────────────────────────
# Both point at the mock_mcp.py FastAPI server started by docker-compose.
MCP_RAVENPACK_ENDPOINT=http://localhost:8001/ravenpack
MCP_RAVENPACK_SECRET=
MCP_RAVENPACK_ROUTING=jsonrpc
MCP_RAVENPACK_VERIFY_SSL=false

MCP_CAPIQ_ENDPOINT=http://localhost:8001/capiq
MCP_CAPIQ_SECRET=
MCP_CAPIQ_ROUTING=jsonrpc
MCP_CAPIQ_VERIFY_SSL=false

# ── Large Response Guard ──────────────────────────────────────────────────────
# Mock server responses are small; set high for local testing.
MAX_OBSERVATION_CHARS=32000

# ── Context / Redis ───────────────────────────────────────────────────────────
# Use Redis offloading locally (docker-compose spins up Redis on 6379).
CONTEXT_STORE_BACKEND=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=devpassword
REDIS_USERNAME=
REDIS_SSL=false

# ── Chain Execution ───────────────────────────────────────────────────────────
CHAIN_MAX_PARALLEL_STEPS=2
CHAIN_DEFAULT_TIMEOUT_MS=120000
CHAIN_DEFAULT_RETRIES=1
CHAIN_ERROR_HANDLING=fail_fast

# ── Summarizer ────────────────────────────────────────────────────────────────
SUMMARIZER_STRATEGY=map_reduce
SUMMARIZER_MAX_TOKENS=4000

# ── ReAct agent ───────────────────────────────────────────────────────────────
REACT_MAX_ITERATIONS=3
REACT_MAX_TOKENS=2048

# ── Research pipeline ─────────────────────────────────────────────────────────
PLANNER_MAX_SUB_QUERIES=3
RESULTS_PER_SOURCE=10
REPORT_FORMAT=markdown

# ── MCP Server (expose this service to Cohere North) ─────────────────────────
# Leave empty to skip bearer auth locally.
MCP_SERVER_SECRET=

# ── Observability ─────────────────────────────────────────────────────────────
AO_ENABLE_TRACING=false
LOG_LEVEL=DEBUG

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1
