# ═══════════════════════════════════════════════════════════════════════════════
#                       MEMORY STORE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# Service Configuration
# ───────────────────────────────────────────────────────────────────────────────
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
SERVICE_WORKERS=4
SERVICE_LOG_LEVEL=INFO
SERVICE_CORS_ENABLED=true
SERVICE_CORS_ORIGINS=*

# Rate limiting
SERVICE_RATE_LIMIT_ENABLED=true
SERVICE_RATE_LIMIT_PER_MINUTE=60

# Health check interval (seconds)
SERVICE_HEALTH_CHECK_INTERVAL=30

# ───────────────────────────────────────────────────────────────────────────────
# Cohere Configuration (REQUIRED)
# ───────────────────────────────────────────────────────────────────────────────
COHERE_API_KEY=your_cohere_api_key_here
COHERE_EMBEDDING_MODEL=embed-english-v3.0
COHERE_SEARCH_MODEL=rerank-english-v3.0

# ───────────────────────────────────────────────────────────────────────────────
# Qdrant Vector Store Configuration (REQUIRED)
# ───────────────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# For Qdrant Cloud, uncomment and set:
# QDRANT_API_KEY=your_qdrant_cloud_api_key_here

QDRANT_COLLECTION_NAME=memory_store
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE_METRIC=cosine

# Performance settings
QDRANT_ON_DISK=false
QDRANT_SHARD_NUMBER=1
QDRANT_REPLICATION_FACTOR=1

# ───────────────────────────────────────────────────────────────────────────────
# LLM_API_KEY=your_api_key_here

# ───────────────────────────────────────────────────────────────────────────────
# Mem0 Configuration
# ───────────────────────────────────────────────────────────────────────────────
MEM0_VERSION=v1.1
MEM0_ORG_ID=your_org_id

# Graph store (optional - requires Neo4j)
MEM0_GRAPH_STORE_ENABLED=false

# Search settings
MEM0_SEARCH_LIMIT=10
MEM0_SEARCH_THRESHOLD=0.7

# Memory management
MEM0_AUTO_PRUNE_ENABLED=false
MEM0_PRUNE_THRESHOLD_DAYS=90

# ───────────────────────────────────────────────────────────────────────────────
# Memgraph Graph Store (OPTIONAL - only if MEM0_GRAPH_STORE_ENABLED=true)
# Enables GraphRAG capabilities for relationship-based memory
# ───────────────────────────────────────────────────────────────────────────────
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=

# Or use full URL
# MEMGRAPH_URL=bolt://localhost:7687

# ═══════════════════════════════════════════════════════════════════════════════
#                       KUBERNETES DEPLOYMENT NOTES
# ═══════════════════════════════════════════════════════════════════════════════
#
# For Kubernetes deployment, use ConfigMaps and Secrets:
#
# ConfigMap for non-sensitive config:
#   kubectl create configmap memory-store-config \
#     --from-literal=SERVICE_HOST=0.0.0.0 \
#     --from-literal=SERVICE_PORT=8000 \
#     --from-literal=QDRANT_URL=http://qdrant-service:6333
#
# Secret for sensitive data:
#   kubectl create secret generic memory-store-secrets \
#     --from-literal=COHERE_API_KEY=your_key \
#     --from-literal=LLM_CLIENT_SECRET=your_secret
#
# ═══════════════════════════════════════════════════════════════════════════════
