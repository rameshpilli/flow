# ═══════════════════════════════════════════════════════════════════════════════
#                        AGENTORCHESTRATOR CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# cp .env.example .env

# ═══════════════════════════════════════════════════════════════════════════════
#                           LLM GATEWAY SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════

# LLM Gateway Server URL (OpenAI-compatible endpoint)
LLM_SERVER_URL=https://llm-gateway.company.com/v1/chat/completions

# Model name to use (e.g., gpt-4, gpt-4-turbo, claude-3-sonnet)
LLM_MODEL_NAME=gpt-4

# Model parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120.0
LLM_VERIFY_SSL=true

# ═══════════════════════════════════════════════════════════════════════════════
#                           AUTHENTICATION
# ═══════════════════════════════════════════════════════════════════════════════
# Choose ONE authentication method: OAuth OR API Key

# Option 1: OAuth Authentication (for enterprise environments)
LLM_OAUTH_ENDPOINT=https://auth.company.com/oauth/token
LLM_CLIENT_ID=your-client-id
LLM_CLIENT_SECRET=your-client-secret

# Option 2: Direct API Key (simpler, for development)
# LLM_API_KEY=sk-your-api-key-here

# ═══════════════════════════════════════════════════════════════════════════════
#                           REDIS SERVICE (OPTIONAL)
# ═══════════════════════════════════════════════════════════════════════════════

# Redis service connection (chat storage, event bus, etc.)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=your-redis-password

# ═══════════════════════════════════════════════════════════════════════════════
#                        S3 OBJECT STORAGE (OPTIONAL)
# ═══════════════════════════════════════════════════════════════════════════════

# S3 service for object storage (requires: pip install agentorchestrator[s3])
# Supports AWS S3 and on-premises S3-compatible services (CAGE S3, MinIO, Ceph)

# Required settings
S3_BUCKET_NAME=your-bucket-name
S3_AWS_ACCESS_KEY_ID=your-access-key
S3_AWS_SECRET_ACCESS_KEY=your-secret-key

# For on-premises S3 (CAGE S3, MinIO, Ceph):
S3_AWS_ENDPOINT_URL=https://your-s3-endpoint.com

# For AWS S3: leave S3_AWS_ENDPOINT_URL blank or unset
# Optional AWS-specific settings:
# S3_REGION=us-east-1
# S3_USE_SSL=true
# S3_VERIFY_SSL=true

# Advanced connection settings (optional):
# S3_SIGNATURE_VERSION=s3v4
# S3_MAX_POOL_CONNECTIONS=10
# S3_CONNECT_TIMEOUT=60
# S3_READ_TIMEOUT=60
# S3_MAX_RETRY_ATTEMPTS=3

# ═══════════════════════════════════════════════════════════════════════════════
#                         CONTEXT STORE (LARGE PAYLOADS)
# ═══════════════════════════════════════════════════════════════════════════════

# Backend: memory, redis, mem0
CONTEXT_STORE_BACKEND=memory
CONTEXT_STORE_REDIS_HOST=localhost
CONTEXT_STORE_REDIS_PORT=6379
# CONTEXT_STORE_REDIS_PASSWORD=your-redis-password
# CONTEXT_STORE_TTL=3600
# CONTEXT_STORE_OFFLOAD_THRESHOLD=100000

# ═══════════════════════════════════════════════════════════════════════════════
#                           MEM0 SEMANTIC MEMORY
# ═══════════════════════════════════════════════════════════════════════════════

# Mem0 service for semantic memory (cross-session recall)
MEM0_URL=https://mem0.company.com
MEM0_AGENT_ID=your-agent-id

# ═══════════════════════════════════════════════════════════════════════════════
#                           VECTOR STORE (RAG)
# ═══════════════════════════════════════════════════════════════════════════════

# Choose provider: memory (default) or cohere_compass
VECTOR_PROVIDER=memory

# Cohere Compass Settings (if provider=cohere_compass)
COHERE_COMPASS_URL=https://your-compass-server.com
COHERE_COMPASS_API_KEY=your-bearer-token
COHERE_COMPASS_INDEX_NAME=your-index-name
COHERE_COMPASS_PARSER_URL=https://your-parser-server.com
VECTOR_VERIFY_SSL=true

# ═══════════════════════════════════════════════════════════════════════════════
#                           SECRET MANAGEMENT
# ═══════════════════════════════════════════════════════════════════════════════

# HashiCorp Vault settings (optional, falls back to .env)
# VAULT_ADDR=https://vault.company.com
# VAULT_TOKEN=your-vault-token

# ═══════════════════════════════════════════════════════════════════════════════
#                           OBSERVABILITY
# ═══════════════════════════════════════════════════════════════════════════════

# Tracing and Metrics
AO_ENABLE_TRACING=true
AO_TRACE_SERVICE=agentorchestrator

# ═══════════════════════════════════════════════════════════════════════════════
#                           DATA AGENTS (MCP)
# ═══════════════════════════════════════════════════════════════════════════════

# Use AGENT_<NAME>_URL pattern or AGENT_CONFIG JSON
# Example:
# AGENT_SEC_URL=https://sec-agent.company.com/api
# AGENT_SEC_API_KEY=your-sec-agent-key
# AGENT_NEWS_URL=https://news-agent.company.com/api
# AGENT_NEWS_API_KEY=your-news-agent-key

# ═══════════════════════════════════════════════════════════════════════════════
#                           FOUNDATION SERVICE
# ═══════════════════════════════════════════════════════════════════════════════

# Foundation DB API for company lookup, earnings calendar, etc.
FOUNDATION_API_URL=https://foundation.company.com/api/v1
FOUNDATION_API_KEY=your-foundation-api-key

# ═══════════════════════════════════════════════════════════════════════════════
#                           CHAIN DEFAULTS
# ═══════════════════════════════════════════════════════════════════════════════

# Execution settings
CHAIN_MAX_PARALLEL_STEPS=5
CHAIN_DEFAULT_TIMEOUT_MS=30000
CHAIN_DEFAULT_RETRIES=3
CHAIN_ERROR_HANDLING=fail_fast

# ═══════════════════════════════════════════════════════════════════════════════
#                           SUMMARIZER SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════

# Maximum tokens for summarized output
SUMMARIZER_MAX_TOKENS=4000

# Chunk size for text splitting
SUMMARIZER_CHUNK_SIZE=2000
SUMMARIZER_CHUNK_OVERLAP=200

# Summarization strategy: stuff, map_reduce, refine
SUMMARIZER_STRATEGY=map_reduce

# ═══════════════════════════════════════════════════════════════════════════════
#                           LOGGING & DEBUG
# ═══════════════════════════════════════════════════════════════════════════════

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable verbose output
VERBOSE=false

# ═══════════════════════════════════════════════════════════════════════════════
#                           CACHE SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════

# OAuth token cache TTL (seconds)
OAUTH_TOKEN_TTL=3500

# Response cache TTL (seconds)
CACHE_TTL_SECONDS=300